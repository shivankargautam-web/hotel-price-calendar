# Copy to .env.local. Leave PRICE_PROVIDER unset (or "demo") for sample data.
PRICE_PROVIDER=demo

# Live provider (server-side only — never use NEXT_PUBLIC_ for these)
HOTEL_API_BASE_URL=
HOTEL_API_KEY=
HOTEL_API_PROVIDER_ID=http
HOTEL_API_PROVIDER_NAME=Hotel availability API
HOTEL_API_BOOKING_HORIZON_DAYS=330
HOTEL_API_MAX_NIGHTS=14
HOTEL_API_REQUESTS_PER_MINUTE=60
HOTEL_API_MAX_QUOTES_PER_SEARCH=120
HOTEL_API_CONCURRENCY=4
HOTEL_API_CACHE_TTL_SECONDS=900
HOTEL_API_TIMEOUT_MS=8000
